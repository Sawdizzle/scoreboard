# Copy to .env.local and fill in from the Supabase project's API settings.
# The publishable key is safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only, never NEXT_PUBLIC_: the secret key (API settings, Secret keys).
# Used to settle AI writes with their token counts, and to send push
# notifications (it reads who to notify). Without it AI writes still count
# toward the monthly cap, and no notifications are sent.
SUPABASE_SECRET_KEY=

# Where parents and leagues send privacy requests (shown on /privacy).
PRIVACY_EMAIL=

# The site's own address, for links in emails (confirm, reset, invites).
# Set it in production, e.g. https://scoreboard.example.com (no trailing slash).
SITE_URL=

# Optional: push notifications (announcements, chat, schedule changes, game
# start and final). Make the pair once with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: address push services can reach you at.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Game start and final pushes come from the database through pg_net: any long
# random string, the same one set as push_hook_secret in private.settings.
PUSH_HOOK_SECRET=
